<!DOCTYPE aesl-source>
<network>

<!--list of global events-->

<!--list of constants-->

<!--show keywords state-->
<keywords flag="true"/>

<!--node thymio-II-->
<node nodeId="51938" name="thymio-II">

onevent prox
	if prox.ground.delta[0] &lt; 400 and prox.ground.delta[1] &lt; 400 then
		motor.left.target = 200
		motor.right.target = 200
	else
		if prox.ground.delta[0] &lt; 400 then
			motor.left.target = 50
			motor.right.target = 200
		else
			if prox.ground.delta[1] &lt; 400 then
				motor.left.target = 200
				motor.right.target = 50
			else
				motor.left.target = 150
				motor.right.target = -150
			end
		end
	end

<toolsPlugins>
<ThymioBlockly>
<xml xmlns="http://www.w3.org/1999/xhtml"><block type="thymio_event_update" x="40" y="40"><field name="EVENT">prox</field><statement name="HANDLER"><block type="controls_if"><mutation else="1"></mutation><value name="IF0"><block type="logic_operation"><field name="OP">AND</field><value name="A"><block type="thymio_prox_ground_check"><field name="SENSOR">prox.ground.delta[0]</field><field name="MODE">BLACK</field></block></value><value name="B"><block type="thymio_prox_ground_check"><field name="SENSOR">prox.ground.delta[1]</field><field name="MODE">BLACK</field></block></value></block></value><statement name="DO0"><block type="thymio_actuator_motor"><field name="VARIABLE">motor.left.target</field><value name="VALUE"><shadow type="math_number"><field name="NUM">200</field></shadow></value><next><block type="thymio_actuator_motor"><field name="VARIABLE">motor.right.target</field><value name="VALUE"><shadow type="math_number"><field name="NUM">200</field></shadow></value></block></next></block></statement><statement name="ELSE"><block type="controls_if"><mutation else="1"></mutation><value name="IF0"><block type="thymio_prox_ground_check"><field name="SENSOR">prox.ground.delta[0]</field><field name="MODE">BLACK</field></block></value><statement name="DO0"><block type="thymio_actuator_motor"><field name="VARIABLE">motor.left.target</field><value name="VALUE"><shadow type="math_number"><field name="NUM">50</field></shadow></value><next><block type="thymio_actuator_motor"><field name="VARIABLE">motor.right.target</field><value name="VALUE"><shadow type="math_number"><field name="NUM">200</field></shadow></value></block></next></block></statement><statement name="ELSE"><block type="controls_if"><mutation else="1"></mutation><value name="IF0"><block type="thymio_prox_ground_check"><field name="SENSOR">prox.ground.delta[1]</field><field name="MODE">BLACK</field></block></value><statement name="DO0"><block type="thymio_actuator_motor"><field name="VARIABLE">motor.left.target</field><value name="VALUE"><shadow type="math_number"><field name="NUM">200</field></shadow></value><next><block type="thymio_actuator_motor"><field name="VARIABLE">motor.right.target</field><value name="VALUE"><shadow type="math_number"><field name="NUM">50</field></shadow></value></block></next></block></statement><statement name="ELSE"><block type="thymio_actuator_motor"><field name="VARIABLE">motor.left.target</field><value name="VALUE"><shadow type="math_number"><field name="NUM">150</field></shadow></value><next><block type="thymio_actuator_motor"><field name="VARIABLE">motor.right.target</field><value name="VALUE"><shadow type="math_number"><field name="NUM">-150</field></shadow></value></block></next></block></statement></block></statement></block></statement></block></statement></block></xml>
</ThymioBlockly>
</toolsPlugins>
</node>

</network>