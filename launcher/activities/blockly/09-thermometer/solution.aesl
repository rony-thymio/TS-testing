<!DOCTYPE aesl-source>
<network>

<!--list of global events-->

<!--list of constants-->

<!--show keywords state-->
<keywords flag="true"/>

<!--node thymio-II-->
<node nodeId="51938" name="thymio-II">

onevent temperature
	if temperature &lt; 200 then
		call leds.top(0,0,32)
	else
		if temperature &gt; 260 then
			call leds.top(32,0,0)
		else
			call leds.top(0,32,0)
		end
	end

<toolsPlugins>
<ThymioBlockly>
<xml xmlns="http://www.w3.org/1999/xhtml"><block type="thymio_event_update" x="40" y="40"><field name="EVENT">temperature</field><statement name="HANDLER"><block type="controls_if"><mutation else="1"></mutation><value name="IF0"><block type="thymio_compare"><field name="OP">LT</field><value name="A"><block type="thymio_sensor_temperature"><field name="SENSOR">temperature</field></block></value><value name="B"><shadow type="math_number"><field name="NUM">200</field></shadow></value></block></value><statement name="DO0"><block type="thymio_led"><field name="LED">leds.top</field><field name="COLOR">#0000ff</field></block></statement><statement name="ELSE"><block type="controls_if"><mutation else="1"></mutation><value name="IF0"><block type="thymio_compare"><field name="OP">GT</field><value name="A"><block type="thymio_sensor_temperature"><field name="SENSOR">temperature</field></block></value><value name="B"><shadow type="math_number"><field name="NUM">260</field></shadow></value></block></value><statement name="DO0"><block type="thymio_led"><field name="LED">leds.top</field><field name="COLOR">#ff0000</field></block></statement><statement name="ELSE"><block type="thymio_led"><field name="LED">leds.top</field><field name="COLOR">#00ff00</field></block></statement></block></statement></block></statement></block></xml>
</ThymioBlockly>
</toolsPlugins>
</node>

</network>