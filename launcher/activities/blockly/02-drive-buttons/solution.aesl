<!DOCTYPE aesl-source>
<network>

<!--list of global events-->

<!--list of constants-->

<!--show keywords state-->
<keywords flag="true"/>

<!--node thymio-II-->
<node nodeId="51938" name="thymio-II">

onevent button.forward
	when button.forward == 1 do
		motor.left.target = 200
		motor.right.target = 200
	end


onevent button.backward
	when button.backward == 1 do
		motor.left.target = -200
		motor.right.target = -200
	end


onevent button.left
	when button.left == 1 do
		motor.left.target = 0
		motor.right.target = 200
	end


onevent button.right
	when button.right == 1 do
		motor.left.target = 200
		motor.right.target = 0
	end


onevent button.center
	when button.center == 1 do
		motor.left.target = 0
		motor.right.target = 0
	end

<toolsPlugins>
<ThymioBlockly>
<xml xmlns="http://www.w3.org/1999/xhtml"><block type="thymio_event_button" x="40" y="40"><field name="BUTTON">button.forward</field><field name="MODE">PRESS</field><statement name="HANDLER"><block type="thymio_motors_start"><field name="COMMAND">FORWARD</field><value name="SPEED"><shadow type="math_number"><field name="NUM">200</field></shadow></value></block></statement></block><block type="thymio_event_button" x="420" y="40"><field name="BUTTON">button.backward</field><field name="MODE">PRESS</field><statement name="HANDLER"><block type="thymio_motors_start"><field name="COMMAND">BACKWARD</field><value name="SPEED"><shadow type="math_number"><field name="NUM">200</field></shadow></value></block></statement></block><block type="thymio_event_button" x="40" y="260"><field name="BUTTON">button.left</field><field name="MODE">PRESS</field><statement name="HANDLER"><block type="thymio_motors_start"><field name="COMMAND">TURNLEFT</field><value name="SPEED"><shadow type="math_number"><field name="NUM">200</field></shadow></value></block></statement></block><block type="thymio_event_button" x="420" y="260"><field name="BUTTON">button.right</field><field name="MODE">PRESS</field><statement name="HANDLER"><block type="thymio_motors_start"><field name="COMMAND">TURNRIGHT</field><value name="SPEED"><shadow type="math_number"><field name="NUM">200</field></shadow></value></block></statement></block><block type="thymio_event_button" x="40" y="480"><field name="BUTTON">button.center</field><field name="MODE">PRESS</field><statement name="HANDLER"><block type="thymio_motors_stop"></block></statement></block></xml>
</ThymioBlockly>
</toolsPlugins>
</node>

</network>