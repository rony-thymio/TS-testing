<!DOCTYPE aesl-source>
<network>

<!--list of global events-->

<!--list of constants-->

<!--show keywords state-->
<keywords flag="true"/>

<!--node thymio-II-->
<node nodeId="51938" name="thymio-II">

onevent button.forward
	when button.forward == 1 do
		motor.left.target = 200
		motor.right.target = 200
	end


onevent prox
	when prox.horizontal[2] &gt; 2000 do
		motor.left.target = 200
		motor.right.target = -200
		call leds.top(32,16,0)
	end

	when prox.horizontal[2] &lt; 1000 do
		motor.left.target = 200
		motor.right.target = 200
		call leds.top(0,32,0)
	end


onevent button.center
	when button.center == 1 do
		motor.left.target = 0
		motor.right.target = 0
		call leds.top(0,0,0)
	end

<toolsPlugins>
<ThymioBlockly>
<xml xmlns="http://www.w3.org/1999/xhtml"><block type="thymio_event_button" x="40" y="40"><field name="BUTTON">button.forward</field><field name="MODE">PRESS</field><statement name="HANDLER"><block type="thymio_motors_start"><field name="COMMAND">FORWARD</field><value name="SPEED"><shadow type="math_number"><field name="NUM">200</field></shadow></value></block></statement></block><block type="thymio_event_prox" x="420" y="40"><field name="SENSOR">prox.horizontal[2]</field><field name="MODE">PROX</field><statement name="HANDLER"><block type="thymio_motors_start"><field name="COMMAND">SPINCW</field><value name="SPEED"><shadow type="math_number"><field name="NUM">200</field></shadow></value><next><block type="thymio_led"><field name="LED">leds.top</field><field name="COLOR">#ff8000</field></block></next></block></statement></block><block type="thymio_event_prox" x="40" y="260"><field name="SENSOR">prox.horizontal[2]</field><field name="MODE">NOPROX</field><statement name="HANDLER"><block type="thymio_motors_start"><field name="COMMAND">FORWARD</field><value name="SPEED"><shadow type="math_number"><field name="NUM">200</field></shadow></value><next><block type="thymio_led"><field name="LED">leds.top</field><field name="COLOR">#00ff00</field></block></next></block></statement></block><block type="thymio_event_button" x="420" y="260"><field name="BUTTON">button.center</field><field name="MODE">PRESS</field><statement name="HANDLER"><block type="thymio_motors_stop"><next><block type="thymio_led_off"><field name="LED">leds.top</field></block></next></block></statement></block></xml>
</ThymioBlockly>
</toolsPlugins>
</node>

</network>