<!DOCTYPE aesl-source>
<network>


<!--list of global events-->


<!--list of constants-->


<!--show keywords state-->
<keywords flag="true"/>


<!--node thymio-II-->
<node nodeId="1" name="thymio-II"># Guard robot: 0 asleep (blue), 1 watching (green), 2 alarm (red)
var state = 0
var i
var seen

call leds.top(0, 0, 32)

onevent tap
    if state == 0 then
        state = 1
        call leds.top(0, 32, 0)
        timer.period[0] = 10000      # watch for 10 s
    end

onevent prox
    if state == 1 then
        seen = 0
        for i in 0:6 do
            if prox.horizontal[i] &gt; 2000 then
                seen = 1
            end
        end
        if seen == 1 then
            state = 2
            timer.period[0] = 0
            call leds.top(32, 0, 0)
            call sound.freq(880, 20)
        end
    end

onevent timer0
    if state == 1 then
        state = 0                    # nobody came: back to sleep
        timer.period[0] = 0
        call leds.top(0, 0, 32)
    end

onevent sound.finished
    if state == 2 then
        call sound.freq(880, 20)     # siren continues
    end

onevent button.center
    if button.center == 1 then
        state = 0
        call leds.top(0, 0, 32)
    end
</node>


</network>
