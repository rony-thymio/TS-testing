<?xml version="1.0" encoding="utf-8"?>
<!-- Thymio Suite MSI: the same firewall rule as the .exe installer (windows/installer-hooks.nsh).
     The device manager only answers programs on the same computer; blocking incoming network
     connections to it means Windows Firewall never asks pupils "allow access?". -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <CustomAction Id="ThymioFirewallAdd" Directory="INSTALLDIR" Execute="deferred" Impersonate="no" Return="ignore"
      ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c netsh advfirewall firewall delete rule name=&quot;Thymio Suite device manager&quot; &amp; netsh advfirewall firewall add rule name=&quot;Thymio Suite device manager&quot; dir=in action=block program=&quot;[INSTALLDIR]thymio-device-manager.exe&quot; enable=yes profile=any" />
    <CustomAction Id="ThymioFirewallRemove" Directory="INSTALLDIR" Execute="deferred" Impersonate="no" Return="ignore"
      ExeCommand="&quot;[SystemFolder]netsh.exe&quot; advfirewall firewall delete rule name=&quot;Thymio Suite device manager&quot;" />
    <InstallExecuteSequence>
      <Custom Action="ThymioFirewallAdd" After="InstallFiles">NOT (REMOVE~="ALL")</Custom>
      <Custom Action="ThymioFirewallRemove" After="InstallInitialize">REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>
    <ComponentGroup Id="ThymioFirewall" />
  </Fragment>
</Wix>
