{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thymio Suite Next",
  "version": "0.21.0",
  "identifier": "org.mobsya.thymiosuite.next",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Thymio Suite",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,LocalNetworkAccessChecks,BlockInsecurePrivateNetworkRequests,PrivateNetworkAccessSendPreflights"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:8597",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "publisher": "Mobsya",
    "category": "Education",
    "shortDescription": "Program Thymio II robots",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/thymio-device-manager"
    ],
    "resources": {
      "../webapps/": "webapps/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "windows/firewall.wxs"
        ],
        "componentGroupRefs": [
          "ThymioFirewall"
        ]
      }
    }
  }
}
